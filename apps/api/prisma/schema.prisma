enum OfferTriggerType {
  MANUAL
  SCHEDULED
  RECURRING_DATE
  BIRTHDAY
  INACTIVITY
}

enum OfferSegment {
  ALL_CUSTOMERS
  BIRTHDAY_THIS_WEEK
  INACTIVE_30_DAYS
  INACTIVE_60_DAYS
  TOP_SPENDERS
  NEW_CUSTOMERS
}

model Offer {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  branchId        String?          @map("branch_id")
  title           String
  messageTemplate String           @map("message_template") @db.Text
  triggerType     OfferTriggerType @map("trigger_type")
  segment         OfferSegment     @default(ALL_CUSTOMERS)
  scheduledFor    DateTime?        @map("scheduled_for")
  recurringMonth  Int?             @map("recurring_month")
  recurringDay    Int?             @map("recurring_day")
  inactivityDays  Int?             @map("inactivity_days")
  isActive        Boolean          @default(true) @map("is_active")
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatches OfferDispatch[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, triggerType])
  @@map("offers")
}

model OfferDispatch {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  offerId           String    @map("offer_id")
  customerId        String    @map("customer_id")
  preparedAt        DateTime? @map("prepared_at")
  managerNotifiedAt DateTime  @default(now()) @map("manager_notified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([offerId, customerId, createdAt])
  @@index([tenantId])
  @@index([offerId])
  @@index([customerId])
  @@map("offer_dispatches")
}

model KitchenTicket {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  branchId       String    @map("branch_id")
  orderId        String    @map("order_id")
  tableId        String?   @map("table_id")
  channel        String
  ticketSequence Int       @map("ticket_sequence")
  status         String    @default("new")
  isAddition     Boolean   @default(false) @map("is_addition")
  printed        Boolean   @default(false)
  printError     String?   @map("print_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  readyAt        DateTime? @map("ready_at")
  servedAt       DateTime? @map("served_at")

  items KitchenTicketItem[]

  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  kitchenTicketId String   @map("kitchen_ticket_id")
  orderItemId     String   @map("order_item_id")
  menuItemName    String   @map("menu_item_name")
  quantity        Int
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  ticket KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)

  @@map("kitchen_ticket_items")
}

model BranchKdsSettings {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  branchId              String   @unique @map("branch_id")
  ticketPrintingEnabled Boolean  @default(false) @map("ticket_printing_enabled")
  printerConnectionType String?  @map("printer_connection_type")
  printerHost           String?  @map("printer_host")
  printerPort           Int?     @map("printer_port")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("branch_kds_settings")
}

