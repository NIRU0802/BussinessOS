model QrCode {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  branchId   String    @map("branch_id")
  tableId    String    @map("table_id")
  tokenHash  String    @unique @map("token_hash")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table    Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessions QrSession[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, tableId])
  @@map("qr_codes")
}

model QrSession {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String    @map("branch_id")
  tableId     String    @map("table_id")
  qrCodeId    String    @map("qr_code_id")
  customerId  String?   @map("customer_id")
  sessionHash String    @unique @map("session_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  qrCode   QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table    Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, tableId])
  @@index([tenantId, customerId])
  @@index([tenantId, expiresAt])
  @@map("qr_sessions")
}

// ============================================================================
// PHASE 6 â€” TABLES, DINE-IN, QR ORDERING, RESERVATIONS
// ============================================================================

enum TableStatus {
  available
  occupied
  preparing
  bill_requested
  paid
}

enum DiningSessionStatus {
  active
  closed
}

enum ReservationStatus {
  pending
  confirmed
  seated
  completed
  cancelled
  no_show
}

model Table {
  id                String      @id @default(uuid())
  tenantId          String      @map("tenant_id")
  branchId          String      @map("branch_id")
  label             String
  capacity          Int         @default(2)
  status            TableStatus @default(available)
  mergedIntoTableId String?     @map("merged_into_table_id")
  qrTokenRotatedAt  DateTime?   @map("qr_token_rotated_at")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mergedInto     Table?          @relation("TableMerge", fields: [mergedIntoTableId], references: [id], onDelete: SetNull)
  mergedTables   Table[]         @relation("TableMerge")
  orders         Order[]
  diningSessions DiningSession[]
  reservations   Reservation[]
  qrCodes        QrCode[]
  qrSessions     QrSession[]

  @@unique([branchId, label])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, status])
  @@map("tables")
}

model DiningSession {
  id        String              @id @default(uuid())
  tenantId  String              @map("tenant_id")
  branchId  String              @map("branch_id")
  tableId   String              @map("table_id")
  partySize Int?                @map("party_size")
  status    DiningSessionStatus @default(active)
  openedBy  String?             @map("opened_by")
  openedAt  DateTime            @default(now()) @map("opened_at")
  closedBy  String?             @map("closed_by")
  closedAt  DateTime?           @map("closed_at")
  notes     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table  Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId])
  @@index([tenantId, tableId, status])
  @@map("dining_sessions")
}

model Reservation {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  branchId        String            @map("branch_id")
  tableId         String?           @map("table_id")
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  partySize       Int               @map("party_size")
  reservedFor     DateTime          @map("reserved_for")
  durationMinutes Int               @default(90) @map("duration_minutes")
  status          ReservationStatus @default(pending)
  notes           String?
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  cancelledAt     DateTime?         @map("cancelled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table  Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, reservedFor])
  @@index([tenantId, tableId])
  @@index([tenantId, status])
  @@map("reservations")
}

// ============================================
// PHASE 9: CRM / CUSTOMER 360
// ============================================

model Customer {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  phone       String
  email       String?
  dob         DateTime? @db.Date
  notes       String?   @db.Text
  preferences Json?     @default("{}")
  totalOrders Int       @default(0) @map("total_orders")
  totalSpent  Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  lastOrderAt DateTime? @map("last_order_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  orders          Order[]
  offerDispatches OfferDispatch[]
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses       CustomerAddress[]
  qrSessions      QrSession[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, dob])
  @@index([tenantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  label      String   @default("Home")
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?  @map("postal_code")
  country    String   @default("IN")
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_addresses")
}

