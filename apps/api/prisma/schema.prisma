// PHASE 8 â€” INVENTORY / STOCK
// ============================================================================

enum StockMovementType {
  purchase
  sale_deduction
  manual_adjustment
  waste
}

model InventoryItem {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  unit        String
  costPerUnit Decimal   @map("cost_per_unit") @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  productIngredients ProductIngredient[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inventory_items")
}

model StockLevel {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  branchId          String   @map("branch_id")
  inventoryItemId   String   @map("inventory_item_id")
  currentQuantity   Decimal  @default(0) @map("current_quantity") @db.Decimal(14, 3)
  lowStockThreshold Decimal  @default(0) @map("low_stock_threshold") @db.Decimal(14, 3)
  updatedAt         DateTime @updatedAt @map("updated_at")

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, inventoryItemId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("stock_levels")
}

model StockMovement {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  branchId         String            @map("branch_id")
  inventoryItemId  String            @map("inventory_item_id")
  changeAmount     Decimal           @map("change_amount") @db.Decimal(14, 3)
  movementType     StockMovementType @map("movement_type")
  reason           String?
  performedBy      String?           @map("performed_by")
  referenceOrderId String?           @map("reference_order_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, branchId, inventoryItemId])
  @@index([tenantId, branchId, createdAt])
  @@map("stock_movements")
}

// NOTE: productId is deliberately a plain String, not a @relation to
// MenuItem â€” matching the existing OrderItem.productId pattern in this
// schema (Phase 4 never FK'd order items to MenuItem either).
model ProductIngredient {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  inventoryItemId String   @map("inventory_item_id")
  quantityUsed    Decimal  @map("quantity_used") @db.Decimal(14, 3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryItemId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("product_ingredients")
}

// =========================================================
// PHASE 2b â€” SUBSCRIPTION & BILLING ENGINE
// =========================================================

enum BillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  paid
  failed
  void
}

enum BillingProviderType {
  razorpay
  stripe
}

enum TenantAddonStatus {
  active
  cancelled
}

model Plan {
  id             String       @id @default(uuid())
  name           String
  price          Decimal      @db.Decimal(12, 2)
  billingCycle   BillingCycle @map("billing_cycle")
  description    String?
  providerPlanId String?      @map("provider_plan_id")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  limits        PlanLimit?
  widgets       PlanWidget[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanLimit {
  id               String @id @default(uuid())
  planId           String @unique @map("plan_id")
  maxBranches      Int?   @map("max_branches")
  maxUsers         Int?   @map("max_users")
  maxDevices       Int?   @map("max_devices")
  maxStorageMb     Int?   @map("max_storage_mb")
  maxMonthlyOrders Int?   @map("max_monthly_orders")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_limits")
}

model PlanWidget {
  id        String @id @default(uuid())
  planId    String @map("plan_id")
  widgetKey String @map("widget_key")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, widgetKey])
  @@map("plan_widgets")
}

model Subscription {
  id                     String               @id @default(uuid())
  tenantId               String               @map("tenant_id")
  planId                 String               @map("plan_id")
  status                 SubscriptionStatus   @default(trialing)
  renewalDate            DateTime             @map("renewal_date")
  startedAt              DateTime             @default(now()) @map("started_at")
  cancelledAt            DateTime?            @map("cancelled_at")
  provider               BillingProviderType? @map("provider")
  providerCustomerId     String?              @map("provider_customer_id")
  providerSubscriptionId String?              @unique @map("provider_subscription_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  subscriptionId String        @map("subscription_id")
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(draft)
  issuedAt       DateTime      @default(now()) @map("issued_at")
  paidAt         DateTime?     @map("paid_at")
  pdfObjectKey   String?       @map("pdf_object_key")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  items        InvoiceItem[]

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model BillingPaymentMethod {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  provider      BillingProviderType
  providerToken String              @map("provider_token")
  isDefault     Boolean             @default(false) @map("is_default")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("payment_methods")
}

model Addon {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(12, 2)
  billingCycle BillingCycle @map("billing_cycle")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenantAddons TenantAddon[]

  @@map("addons")
}

model TenantAddon {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  addonId     String            @map("addon_id")
  activatedAt DateTime          @default(now()) @map("activated_at")
  status      TenantAddonStatus @default(active)

  addon Addon @relation(fields: [addonId], references: [id])

  @@index([tenantId])
  @@map("tenant_addons")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  branchId         String    @map("branch_id")
  categoryId       String    @map("category_id")
  amount           Decimal   @db.Decimal(12, 2)
  description      String?
  expenseDate      DateTime  @map("expense_date") @db.Date
  receiptObjectKey String?   @map("receipt_object_key")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId, branchId, expenseDate])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
  @@map("expenses")
}

// ============================================================
// SUPER ADMIN PORTAL — Phase 15
// Platform-level identities. Deliberately OUTSIDE tenant RLS.
// Never linked to the tenant `staff`/user model.
// ============================================================

enum SuperAdminType {
  GR8
  TEAM
}

enum SuperAdminStatus {
  active
  suspended
  disabled
}

model SuperAdminUser {
  id            String           @id @default(uuid())
  email         String           @unique
  password_hash String
  full_name     String
  admin_type    SuperAdminType
  status        SuperAdminStatus @default(active)

  // Security / lockout — mirrors tenant security alert pattern (Section 13)
  failed_login_count Int       @default(0)
  locked_until       DateTime?
  last_login_at      DateTime?
  last_login_ip      String?

  // Refresh token rotation (mirrors tenant auth pattern)
  refreshTokens SuperAdminRefreshToken[]
  auditLogs     SuperAdminAuditLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("super_admin_users")
}

model SuperAdminRefreshToken {
  id             String         @id @default(uuid())
  super_admin_id String
  superAdmin     SuperAdminUser @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)
  token_hash     String         @unique
  expires_at     DateTime
  revoked_at     DateTime?
  created_at     DateTime       @default(now())
  ip_address     String?
  user_agent     String?

  @@index([super_admin_id])
  @@map("super_admin_refresh_tokens")
}

// Every SuperAdmin action is written here — separate from the tenant AuditLog
// model so cross-tenant actions never get filtered out by tenant RLS policies.
model SuperAdminAuditLog {
  id String @id @default(uuid())

  // Actor
  super_admin_id     String
  superAdmin         SuperAdminUser @relation(fields: [super_admin_id], references: [id])
  admin_type_at_time SuperAdminType // snapshot — in case admin's tier changes later

  // Target (nullable tenant_id = platform-wide action, e.g. "listed all tenants")
  target_tenant_id String?

  action        String // e.g. "tenant.suspend", "plan.update", "widget.disable"
  resource_type String // e.g. "tenant", "plan", "widget", "feature_flag"
  resource_id   String?

  metadata   Json? // request payload snapshot, before/after diff, etc.
  ip_address String?
  user_agent String?

  created_at DateTime @default(now())

  @@index([super_admin_id])
  @@index([target_tenant_id])
  @@index([action])
  @@index([created_at])
  @@map("super_admin_audit_logs")
}

// ============================================================
// FEATURE FLAGS — Phase 15
// Global flags + per-tenant overrides, simple key/value + scope model
// ============================================================

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  description       String?
  isEnabledGlobally Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagTenantOverride[]

  @@map("feature_flags")
}

model FeatureFlagTenantOverride {
  id            String   @id @default(uuid())
  featureFlagId String   @map("feature_flag_id")
  tenantId      String   @map("tenant_id")
  isEnabled     Boolean  @map("is_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, tenantId])
  @@index([tenantId])
  @@map("feature_flag_tenant_overrides")
}

// ============================================================
// PER-BRANCH WIDGET OVERRIDES — Phase 15 extension
// Lets Super Admin enable/disable a widget for one specific branch,
// independent of the tenant-wide TenantWidget setting. This is a
// CONTROL SURFACE ONLY in this phase — enforcement across Orders/
// Menu/KDS/etc. is a separate future phase, not built yet.
// ============================================================

model BranchWidgetOverride {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  widgetKey String   @map("widget_key")
  isEnabled Boolean  @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, widgetKey])
  @@index([tenantId])
  @@index([branchId])
  @@map("branch_widget_overrides")
}
