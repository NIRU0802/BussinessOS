NODE_ENV=development
APP_NAME=business-os
API_PORT=4000
API_HOST=0.0.0.0

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
QR_TOKEN_HMAC_SECRET=replace_with_a_random_secret_at_least_32_characters_long
COOKIE_SECRET=replace_with_a_random_secret_at_least_32_characters_long

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=business_os
POSTGRES_USER=business_os_app
POSTGRES_PASSWORD=replace_with_a_strong_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=business-os

PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

LOG_LEVEL=info